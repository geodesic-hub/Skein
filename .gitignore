# Android / Gradle .gitignore

# Built artifacts
*.apk
*.aab
*.ap_
*.dex
*.class

# Gradle
.gradle/
/build/
/captures/
/app/build/

# Local config — machine-specific, do NOT commit (contains your SDK path)
local.properties

# Android Studio / IntelliJ
*.iml
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.idea/deploymentTargetDropDown.xml
.idea/deploymentTargetSelector.xml

# Signing keys / secrets — NEVER commit these
*.jks
*.keystore
keystore.properties

# Native build
.externalNativeBuild/
.cxx/

# OS junk
.DS_Store
*.log
hs_err_pid*

# Design handoff reference (not part of the app)
design_handoff_peachy_messages/
